{
    "name": "pixi",
    "displayName": "Pixi",
    "description": "Pixi package manager and polyglot workspace integration for Visual Studio Code",
    "icon": "assets/icon.png",
    "license": "MIT",
    "version": "1.0.0",
    "homepage": "https://github.com/SheepTAO/pixi#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/SheepTAO/pixi.git"
    },
    "bugs": {
        "url": "https://github.com/SheepTAO/pixi/issues"
    },
    "keywords": [
        "pixi",
        "conda",
        "pypi",
        "python",
        "package-manager",
        "workspace"
    ],
    "engines": {
        "vscode": "^1.118.0"
    },
    "categories": [
        "Data Science",
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:python",
        "workspaceContains:**/pixi.toml",
        "workspaceContains:**/pyproject.toml"
    ],
    "publisher": "sheeptao",
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "pixi.install",
                "title": "Install (Sync Environments)",
                "category": "Pixi",
                "icon": "$(cloud-download)"
            },
            {
                "command": "pixi.update",
                "title": "Update Dependencies",
                "category": "Pixi",
                "icon": "$(sync)"
            },
            {
                "command": "pixi.addPackage",
                "title": "Add Package ...",
                "category": "Pixi",
                "icon": "$(add)"
            },
            {
                "command": "pixi.removePackage",
                "title": "Remove Package ...",
                "category": "Pixi",
                "icon": "$(trash)"
            },
            {
                "command": "pixi.runTask",
                "title": "Run Task",
                "category": "Pixi"
            },
            {
                "command": "pixi.runTaskInEnvironment",
                "title": "Run Task in Environment ...",
                "category": "Pixi"
            },
            {
                "command": "pixi.openTerminal",
                "title": "Open Terminal in Environment ...",
                "category": "Pixi"
            },
            {
                "command": "pixi.init",
                "title": "Initialize Project ...",
                "category": "Pixi"
            },
            {
                "command": "pixi.createEnvironment",
                "title": "Create Environment ...",
                "category": "Pixi",
                "icon": "$(plus)"
            },
            {
                "command": "pixi.deleteEnvironment",
                "title": "Delete Environment ...",
                "category": "Pixi",
                "icon": "$(trash)"
            },
            {
                "command": "pixi.clean",
                "title": "Clean ...",
                "category": "Pixi",
                "icon": "$(clear-all)"
            },
            {
                "command": "pixi.lock",
                "title": "Lock Dependencies",
                "category": "Pixi",
                "icon": "$(lock)"
            },
            {
                "command": "pixi.reinstall",
                "title": "Reinstall Environment ...",
                "category": "Pixi",
                "icon": "$(debug-restart)"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "pixi.init",
                    "when": "!pixi.hasPixiProject"
                },
                {
                    "command": "pixi.createEnvironment"
                },
                {
                    "command": "pixi.deleteEnvironment",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.clean",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.lock",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.install",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.update",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.reinstall",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.addPackage",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.removePackage",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.runTask",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.runTaskInEnvironment",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.openTerminal",
                    "when": "pixi.hasPixiProject"
                }
            ],
            "editor/title": [
                {
                    "command": "pixi.lock",
                    "when": "resourceExtname == .toml && (resourceFilename == pixi.toml || resourceFilename == pyproject.toml) && pixi.hasPixiProject",
                    "group": "navigation@1"
                },
                {
                    "command": "pixi.install",
                    "when": "resourceExtname == .toml && (resourceFilename == pixi.toml || resourceFilename == pyproject.toml) && pixi.hasPixiProject",
                    "group": "navigation@2"
                },
                {
                    "command": "pixi.update",
                    "when": "resourceExtname == .toml && (resourceFilename == pixi.toml || resourceFilename == pyproject.toml) && pixi.hasPixiProject",
                    "group": "navigation@3"
                },
                {
                    "command": "pixi.reinstall",
                    "when": "resourceExtname == .toml && (resourceFilename == pixi.toml || resourceFilename == pyproject.toml) && pixi.hasPixiProject",
                    "group": "navigation@4"
                }
            ]
        },
        "terminal": {
            "profiles": [
                {
                    "id": "pixi.terminal",
                    "title": "Pixi",
                    "icon": "prefix-dev"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "pixi",
                "required": [
                    "task"
                ],
                "properties": {
                    "task": {
                        "type": "string",
                        "description": "The Pixi task name to execute"
                    },
                    "environment": {
                        "type": "string",
                        "description": "Optional environment in which to execute the task"
                    }
                }
            }
        ],
        "configurationDefaults": {
            "python-envs.workspaceSearchPaths": [
                ".venv",
                "*/.venv",
                ".pixi",
                "*/.pixi"
            ]
        },
        "configuration": {
            "title": "Pixi",
            "properties": {
                "pixi.executablePath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Pixi executable (supports relative paths and ${workspaceFolder}). Leave empty to use auto-discovery.",
                    "scope": "machine-overridable"
                },
                "pixi.searchIgnorePatterns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/node_modules/**",
                        "**/.git/**",
                        "**/dist/**",
                        "**/build/**",
                        "**/.venv/**",
                        "**/.pixi/*/**"
                    ],
                    "description": "Glob patterns to exclude when searching for Pixi projects in the workspace.",
                    "scope": "resource"
                },
                "pixi.environmentRules": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Rules to map glob patterns to Pixi environment names (format: 'pattern=env' or 'pattern:env', e.g. 'tests/**=dev', 'train/**=train'). Click 'Add Item' to add rules.",
                    "scope": "resource"
                },
                "pixi.displayNameFormat": {
                    "type": "string",
                    "default": "${project}:${env}",
                    "description": "Format template for environment display names. Supported placeholders: ${project} (or {{project}}), ${env}, ${python} (or ${version}).",
                    "scope": "resource"
                }
            }
        },
        "icons": {
            "prefix-dev": {
                "description": "Prefix Logo",
                "default": {
                    "fontPath": "./assets/prefix-dev.woff",
                    "fontCharacter": "\\E800"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "package-vsix": "npx @vscode/vsce package -o dist/",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "test": "npm run pretest",
        "lint": "eslint src",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@types/node": "24.x",
        "@types/picomatch": "^4.0.3",
        "@types/semver": "^7.7.1",
        "@types/vscode": "^1.118.0",
        "@types/which": "^3.0.4",
        "@typescript-eslint/eslint-plugin": "^8.59.1",
        "@typescript-eslint/parser": "^8.59.1",
        "eslint": "^10.2.1",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "prettier": "^3.8.3",
        "ts-loader": "^9.5.7",
        "typescript": "^6.0.3",
        "webpack": "^5.106.2",
        "webpack-cli": "^7.0.2"
    },
    "dependencies": {
        "@vscode/python-environments": "^1.0.0",
        "fast-glob": "^3.3.3",
        "picomatch": "^4.0.7",
        "semver": "^7.7.4",
        "which": "^6.0.1"
    }
}
