{
    "name": "pixi",
    "displayName": "Pixi",
    "description": "Pixi package manager and polyglot workspace integration for Visual Studio Code",
    "icon": "assets/icon.png",
    "license": "MIT",
    "version": "1.0.1",
    "homepage": "https://github.com/SheepTAO/pixi#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/SheepTAO/pixi.git"
    },
    "bugs": {
        "url": "https://github.com/SheepTAO/pixi/issues"
    },
    "keywords": [
        "pixi",
        "conda",
        "pypi",
        "python",
        "package-manager",
        "workspace"
    ],
    "engines": {
        "vscode": "^1.118.0"
    },
    "categories": [
        "Data Science",
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:python",
        "workspaceContains:**/pixi.toml",
        "workspaceContains:**/pyproject.toml"
    ],
    "publisher": "sheeptao",
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "pixi.install",
                "title": "Install (Sync Environments)",
                "category": "Pixi",
                "icon": "$(cloud-download)"
            },
            {
                "command": "pixi.update",
                "title": "Update Dependencies",
                "category": "Pixi",
                "icon": "$(sync)"
            },
            {
                "command": "pixi.searchPackages",
                "title": "Search Packages ...",
                "category": "Pixi",
                "icon": "$(search)"
            },
            {
                "command": "pixi.addPackage",
                "title": "Add Package ...",
                "category": "Pixi",
                "icon": "$(plus)"
            },
            {
                "command": "pixi.removePackage",
                "title": "Remove Package ...",
                "category": "Pixi",
                "icon": "$(trash)"
            },
            {
                "command": "pixi.addChannel",
                "title": "Add Channel ...",
                "category": "Pixi",
                "icon": "$(globe)"
            },
            {
                "command": "pixi.removeChannel",
                "title": "Remove Channel ...",
                "category": "Pixi",
                "icon": "$(trash)"
            },
            {
                "command": "pixi.runTask",
                "title": "Run Task",
                "category": "Pixi"
            },
            {
                "command": "pixi.runTaskInEnvironment",
                "title": "Run Task in Environment ...",
                "category": "Pixi"
            },
            {
                "command": "pixi.openTerminal",
                "title": "Open Terminal in Environment ...",
                "category": "Pixi",
                "icon": "$(terminal)"
            },
            {
                "command": "pixi.init",
                "title": "Initialize Project ...",
                "category": "Pixi",
                "icon": "$(plus)"
            },
            {
                "command": "pixi.createEnvironment",
                "title": "Create Environment ...",
                "category": "Pixi",
                "icon": "$(plus)"
            },
            {
                "command": "pixi.deleteEnvironment",
                "title": "Delete Environment ...",
                "category": "Pixi",
                "icon": "$(trash)"
            },
            {
                "command": "pixi.clean",
                "title": "Clean ...",
                "category": "Pixi",
                "icon": "$(clear-all)"
            },
            {
                "command": "pixi.lock",
                "title": "Lock Dependencies",
                "category": "Pixi",
                "icon": "$(lock)"
            },
            {
                "command": "pixi.reinstall",
                "title": "Reinstall Environment ...",
                "category": "Pixi",
                "icon": "$(debug-restart)"
            },
            {
                "command": "pixi.global",
                "title": "Global Tools ...",
                "category": "Pixi",
                "icon": "$(tools)"
            },
            {
                "command": "pixi.refreshProjects",
                "title": "Refresh Projects",
                "category": "Pixi",
                "icon": "$(refresh)"
            },
            {
                "command": "pixi.refreshGlobal",
                "title": "Refresh Global Tools",
                "category": "Pixi",
                "icon": "$(refresh)"
            },
            {
                "command": "pixi.global.install",
                "title": "Install Global Tool ...",
                "category": "Pixi",
                "icon": "$(plus)"
            },
            {
                "command": "pixi.global.sync",
                "title": "Sync Global Environments",
                "category": "Pixi",
                "icon": "$(repo-sync)"
            },
            {
                "command": "pixi.global.updateTool",
                "title": "Update Global Tool",
                "category": "Pixi",
                "icon": "$(arrow-up)"
            },
            {
                "command": "pixi.global.uninstallTool",
                "title": "Uninstall Global Tool",
                "category": "Pixi",
                "icon": "$(trash)"
            },
            {
                "command": "pixi.global.openManifest",
                "title": "Open Global Manifest",
                "category": "Pixi",
                "icon": "$(edit)"
            },
            {
                "command": "pixi.selfUpdate",
                "title": "Update Pixi CLI ...",
                "category": "Pixi",
                "icon": "$(arrow-up)"
            },
            {
                "command": "pixi.refreshInfo",
                "title": "Refresh Pixi Info",
                "category": "Pixi",
                "icon": "$(refresh)"
            },
            {
                "command": "pixi.cleanCache",
                "title": "Clean Package Cache ...",
                "category": "Pixi",
                "icon": "$(trash)"
            },
            {
                "command": "pixi.measureCacheSize",
                "title": "Measure Cache Size",
                "category": "Pixi",
                "icon": "$(dashboard)"
            },
            {
                "command": "pixi.openLocation",
                "title": "Open Location ...",
                "category": "Pixi"
            },
            {
                "command": "pixi.showDependencyTree",
                "title": "Show Dependency Tree",
                "category": "Pixi",
                "icon": "$(list-tree)"
            },
            {
                "command": "pixi.whyPackage",
                "title": "Why is This Installed? (Reverse Tree)",
                "category": "Pixi",
                "icon": "$(type-hierarchy-sub)"
            },
            {
                "command": "pixi.updatePackage",
                "title": "Update Package",
                "category": "Pixi",
                "icon": "$(arrow-up)"
            },
            {
                "command": "pixi.revealPackageInManifest",
                "title": "Go to Definition in Manifest",
                "category": "Pixi",
                "icon": "$(go-to-file)"
            },
            {
                "command": "pixi.copyPackageName",
                "title": "Copy Package Name",
                "category": "Pixi",
                "icon": "$(copy)"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "pixi.searchPackages"
                },
                {
                    "command": "pixi.selfUpdate"
                },
                {
                    "command": "pixi.refreshInfo"
                },
                {
                    "command": "pixi.cleanCache"
                },
                {
                    "command": "pixi.openLocation",
                    "when": "false"
                },
                {
                    "command": "pixi.global"
                },
                {
                    "command": "pixi.init",
                    "when": "!pixi.hasPixiProject"
                },
                {
                    "command": "pixi.createEnvironment"
                },
                {
                    "command": "pixi.deleteEnvironment",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.clean",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.lock",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.install",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.update",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.reinstall",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.addPackage",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.removePackage",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.addChannel",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.removeChannel",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.runTask",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.runTaskInEnvironment",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.openTerminal",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.showDependencyTree",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.whyPackage",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.updatePackage",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.revealPackageInManifest",
                    "when": "pixi.hasPixiProject"
                },
                {
                    "command": "pixi.copyPackageName",
                    "when": "pixi.hasPixiProject"
                }
            ],
            "editor/title": [
                {
                    "command": "pixi.lock",
                    "when": "resourceExtname == .toml && (resourceFilename == pixi.toml || resourceFilename == pyproject.toml) && pixi.hasPixiProject",
                    "group": "navigation@1"
                },
                {
                    "command": "pixi.install",
                    "when": "resourceExtname == .toml && (resourceFilename == pixi.toml || resourceFilename == pyproject.toml) && pixi.hasPixiProject",
                    "group": "navigation@2"
                },
                {
                    "command": "pixi.update",
                    "when": "resourceExtname == .toml && (resourceFilename == pixi.toml || resourceFilename == pyproject.toml) && pixi.hasPixiProject",
                    "group": "navigation@3"
                },
                {
                    "command": "pixi.reinstall",
                    "when": "resourceExtname == .toml && (resourceFilename == pixi.toml || resourceFilename == pyproject.toml) && pixi.hasPixiProject",
                    "group": "navigation@4"
                }
            ],
            "view/title": [
                {
                    "command": "pixi.addPackage",
                    "when": "view == pixi.views.projects && pixi.hasPixiProject",
                    "group": "navigation@1"
                },
                {
                    "command": "pixi.refreshProjects",
                    "when": "view == pixi.views.projects",
                    "group": "navigation@2"
                },
                {
                    "command": "pixi.install",
                    "when": "view == pixi.views.projects && pixi.hasPixiProject",
                    "group": "navigation@3"
                },
                {
                    "command": "pixi.lock",
                    "when": "view == pixi.views.projects && pixi.hasPixiProject",
                    "group": "1_manage@1"
                },
                {
                    "command": "pixi.init",
                    "when": "view == pixi.views.projects && !pixi.hasPixiProject",
                    "group": "1_manage@2"
                },
                {
                    "command": "pixi.global.install",
                    "when": "view == pixi.views.global",
                    "group": "navigation@1"
                },
                {
                    "command": "pixi.refreshGlobal",
                    "when": "view == pixi.views.global",
                    "group": "navigation@2"
                },
                {
                    "command": "pixi.global.sync",
                    "when": "view == pixi.views.global",
                    "group": "1_tools@1"
                },
                {
                    "command": "pixi.global.openManifest",
                    "when": "view == pixi.views.global",
                    "group": "1_tools@2"
                },
                {
                    "command": "pixi.selfUpdate",
                    "when": "view == pixi.views.info",
                    "group": "navigation@1"
                },
                {
                    "command": "pixi.refreshInfo",
                    "when": "view == pixi.views.info",
                    "group": "navigation@2"
                }
            ],
            "view/item/context": [
                {
                    "command": "pixi.addPackage",
                    "when": "view == pixi.views.projects && viewItem == pixiProject",
                    "group": "inline@1"
                },
                {
                    "command": "pixi.createEnvironment",
                    "when": "view == pixi.views.projects && viewItem == pixiProject",
                    "group": "1_manage@1"
                },
                {
                    "command": "pixi.lock",
                    "when": "view == pixi.views.projects && viewItem == pixiProject",
                    "group": "1_manage@2"
                },
                {
                    "command": "pixi.addChannel",
                    "when": "view == pixi.views.projects && viewItem == pixiProject",
                    "group": "2_channel@1"
                },
                {
                    "command": "pixi.removeChannel",
                    "when": "view == pixi.views.projects && viewItem == pixiProject",
                    "group": "2_channel@2"
                },
                {
                    "command": "pixi.addPackage",
                    "when": "view == pixi.views.projects && (viewItem == pixiEnvInstalled || viewItem == pixiEnvUninstalled)",
                    "group": "inline@0"
                },
                {
                    "command": "pixi.openTerminal",
                    "when": "view == pixi.views.projects && viewItem == pixiEnvInstalled",
                    "group": "inline@1"
                },
                {
                    "command": "pixi.reinstall",
                    "when": "view == pixi.views.projects && viewItem == pixiEnvInstalled",
                    "group": "inline@2"
                },
                {
                    "command": "pixi.addPackage",
                    "when": "view == pixi.views.projects && (viewItem == pixiEnvInstalled || viewItem == pixiEnvUninstalled || viewItem == pixiEmpty)",
                    "group": "1_package@1"
                },
                {
                    "command": "pixi.removePackage",
                    "when": "view == pixi.views.projects && viewItem == pixiEnvInstalled",
                    "group": "1_package@2"
                },
                {
                    "command": "pixi.update",
                    "when": "view == pixi.views.projects && (viewItem == pixiEnvInstalled || viewItem == pixiEmpty)",
                    "group": "1_package@3"
                },
                {
                    "command": "pixi.updatePackage",
                    "when": "view == pixi.views.projects && viewItem == pixiPackageExplicit",
                    "group": "inline@1"
                },
                {
                    "command": "pixi.removePackage",
                    "when": "view == pixi.views.projects && viewItem == pixiPackageExplicit",
                    "group": "inline@2"
                },
                {
                    "command": "pixi.updatePackage",
                    "when": "view == pixi.views.projects && (viewItem == pixiPackageExplicit || viewItem == pixiPackageTransitive)",
                    "group": "1_item@1"
                },
                {
                    "command": "pixi.removePackage",
                    "when": "view == pixi.views.projects && viewItem == pixiPackageExplicit",
                    "group": "1_item@2"
                },
                {
                    "command": "pixi.revealPackageInManifest",
                    "when": "view == pixi.views.projects && viewItem == pixiPackageExplicit",
                    "group": "1_item@3"
                },
                {
                    "command": "pixi.whyPackage",
                    "when": "view == pixi.views.projects && viewItem == pixiPackageTransitive",
                    "group": "inline@1"
                },
                {
                    "command": "pixi.showDependencyTree",
                    "when": "view == pixi.views.projects && viewItem == pixiTransitiveGroup",
                    "group": "inline@1"
                },
                {
                    "command": "pixi.showDependencyTree",
                    "when": "view == pixi.views.projects && (viewItem == pixiEnvInstalled || viewItem == pixiPackageExplicit || viewItem == pixiPackageTransitive || viewItem == pixiTransitiveGroup)",
                    "group": "2_tree@1"
                },
                {
                    "command": "pixi.whyPackage",
                    "when": "view == pixi.views.projects && (viewItem == pixiEnvInstalled || viewItem == pixiPackageExplicit || viewItem == pixiPackageTransitive || viewItem == pixiTransitiveGroup)",
                    "group": "2_tree@2"
                },
                {
                    "command": "pixi.copyPackageName",
                    "when": "view == pixi.views.projects && (viewItem == pixiPackageExplicit || viewItem == pixiPackageTransitive)",
                    "group": "3_copy@1"
                },
                {
                    "command": "pixi.deleteEnvironment",
                    "when": "view == pixi.views.projects && (viewItem == pixiEnvInstalled || viewItem == pixiEnvUninstalled)",
                    "group": "2_manage@1"
                },
                {
                    "command": "pixi.install",
                    "when": "view == pixi.views.projects && viewItem == pixiEnvUninstalled",
                    "group": "inline@1"
                },
                {
                    "command": "pixi.global.updateTool",
                    "when": "view == pixi.views.global && viewItem == pixiGlobalTool",
                    "group": "inline@1"
                },
                {
                    "command": "pixi.global.uninstallTool",
                    "when": "view == pixi.views.global && viewItem == pixiGlobalTool",
                    "group": "inline@2"
                },
                {
                    "command": "pixi.cleanCache",
                    "when": "view == pixi.views.info && viewItem == pixiInfoCache",
                    "group": "inline@1"
                },
                {
                    "command": "pixi.measureCacheSize",
                    "when": "view == pixi.views.info && viewItem == pixiInfoCache",
                    "group": "inline@2"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "pixi-view",
                    "title": "Pixi",
                    "icon": "assets/pixi-activity.svg"
                }
            ]
        },
        "views": {
            "pixi-view": [
                {
                    "id": "pixi.views.projects",
                    "name": "Environments",
                    "icon": "assets/pixi-activity.svg"
                },
                {
                    "id": "pixi.views.global",
                    "name": "Global Tools",
                    "icon": "assets/pixi-activity.svg"
                },
                {
                    "id": "pixi.views.info",
                    "name": "Pixi Info",
                    "icon": "assets/pixi-activity.svg"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "pixi.views.projects",
                "contents": "No Pixi projects found in current workspace.\n[Initialize Pixi Project](command:pixi.init)",
                "when": "!pixi.hasPixiProject"
            },
            {
                "view": "pixi.views.global",
                "contents": "No global tools installed.\n[Install Global Tool](command:pixi.global.install)"
            }
        ],
        "terminal": {
            "profiles": [
                {
                    "id": "pixi.terminal",
                    "title": "Pixi",
                    "icon": "prefix-dev"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "pixi",
                "required": [
                    "task"
                ],
                "properties": {
                    "task": {
                        "type": "string",
                        "description": "The Pixi task name to execute"
                    },
                    "environment": {
                        "type": "string",
                        "description": "Optional environment in which to execute the task"
                    }
                }
            }
        ],
        "configurationDefaults": {
            "python-envs.workspaceSearchPaths": [
                ".venv",
                "*/.venv",
                ".pixi",
                "*/.pixi"
            ]
        },
        "configuration": {
            "title": "Pixi",
            "properties": {
                "pixi.executablePath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Pixi executable (supports relative paths and ${workspaceFolder}). Leave empty to use auto-discovery.",
                    "scope": "machine-overridable"
                },
                "pixi.searchIgnorePatterns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/node_modules/**",
                        "**/.git/**",
                        "**/dist/**",
                        "**/build/**",
                        "**/.venv/**",
                        "**/.pixi/*/**"
                    ],
                    "description": "Glob patterns to exclude when searching for Pixi projects in the workspace.",
                    "scope": "resource"
                },
                "pixi.environmentRules": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Rules to map glob patterns to Pixi environment names (format: 'pattern=env' or 'pattern:env', e.g. 'tests/**=dev', 'train/**=train'). Click 'Add Item' to add rules.",
                    "scope": "resource"
                },
                "pixi.displayNameFormat": {
                    "type": "string",
                    "default": "${project}:${env}",
                    "description": "Format template for environment display names. Supported placeholders: ${project} (or {{project}}), ${env}, ${version} (or {{version}}).",
                    "scope": "resource"
                },
                "pixi.defaultManifestFormat": {
                    "type": "string",
                    "enum": [
                        "ask",
                        "pixi",
                        "pyproject"
                    ],
                    "enumDescriptions": [
                        "Always prompt to choose between pixi.toml and pyproject.toml",
                        "Use pixi.toml format",
                        "Use pyproject.toml format"
                    ],
                    "default": "ask",
                    "description": "Default manifest format when initializing a new Pixi project.",
                    "scope": "resource"
                },
                "pixi.autoInstallOnOpen": {
                    "type": "string",
                    "enum": [
                        "prompt",
                        "always",
                        "never"
                    ],
                    "enumDescriptions": [
                        "Prompt to install uninstalled Pixi environments when opening a project",
                        "Automatically install uninstalled environments in the background",
                        "Never prompt or automatically install environments on open"
                    ],
                    "default": "prompt",
                    "description": "Control automatic environment installation when opening a Pixi project with uninstalled environments.",
                    "scope": "resource"
                },
                "pixi.terminal.defaultEnvironment": {
                    "type": "string",
                    "default": "",
                    "description": "Default environment name to activate when opening a Pixi terminal (e.g. 'default' or 'dev'). If empty, prompts for selection when multiple environments exist.",
                    "scope": "resource"
                },
                "pixi.packageSearch.includePypi": {
                    "type": "boolean",
                    "default": true,
                    "description": "Include PyPI packages in package search results.",
                    "scope": "resource"
                },
                "pixi.packages.displayMode": {
                    "type": "string",
                    "enum": [
                        "grouped",
                        "explicitOnly",
                        "all"
                    ],
                    "enumDescriptions": [
                        "Group transitive dependencies under a collapsible 'Transitive Dependencies' folder (recommended)",
                        "Show only explicit dependencies declared in the project manifest",
                        "Show all packages in a flat list"
                    ],
                    "default": "grouped",
                    "description": "Control how installed packages are displayed in the Environments tree view.",
                    "scope": "resource"
                },
                "pixi.cache.autoMeasureSize": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically compute the disk size of Pixi/Rattler cache directories in the Pixi Info view.",
                    "scope": "window"
                }
            }
        },
        "icons": {
            "prefix-dev": {
                "description": "Prefix Logo",
                "default": {
                    "fontPath": "./assets/prefix-dev.woff",
                    "fontCharacter": "\\E800"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "package-vsix": "npx @vscode/vsce package -o dist/",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "test": "npm run pretest",
        "lint": "eslint src",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@types/node": "24.x",
        "@types/picomatch": "^4.0.3",
        "@types/semver": "^7.7.1",
        "@types/vscode": "^1.118.0",
        "@types/which": "^3.0.4",
        "@typescript-eslint/eslint-plugin": "^8.59.1",
        "@typescript-eslint/parser": "^8.59.1",
        "eslint": "^10.2.1",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "prettier": "^3.8.3",
        "ts-loader": "^9.5.7",
        "typescript": "^6.0.3",
        "webpack": "^5.106.2",
        "webpack-cli": "^7.0.2"
    },
    "dependencies": {
        "@vscode/python-environments": "^1.0.0",
        "fast-glob": "^3.3.3",
        "picomatch": "^4.0.7",
        "semver": "^7.7.4",
        "which": "^6.0.1"
    }
}
